{
  "expo": {
    "name": "SHR",
    "slug": "shr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/adaptive-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.brokerapp"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon-shr.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font"
    ]
  }
}
