# Copy to `.env` and fill in. Expo inlines EXPO_PUBLIC_* at BUNDLE time, so
# restart Metro with `npx expo start -c` after any edit — a running server keeps
# serving the old values.

# Backend host. From a phone, `localhost` means the PHONE, not your machine:
#   • USB      → run `adb reverse tcp:5000 tcp:5000`, then localhost works
#   • Wi-Fi    → use your machine's LAN IP, e.g. http://192.168.1.5:5000
EXPO_PUBLIC_BASE_URL="https://your-backend.example.com"

# Identifies this client to the backend audit trail (X-App-Source header).
EXPO_PUBLIC_APP_SOURCE="STAFFCORE"

# Minutes before a break counts as "long" in attendance.
EXPO_PUBLIC_LONG_BREAK_MIN="50"

# Terms & Conditions page opened from the login screen. While empty, the link
# tells the user it isn't configured instead of opening a dead URL.
EXPO_PUBLIC_TERMS_URL=""
